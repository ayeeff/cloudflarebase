{
	"name": "@cloudflarebase/hosting",
	"version": "0.7.0",
	"description": "Apps and functions on Cloudflare Workers for Platforms - static assets and server code in one deploy, one Durable Object orchestrator per project - the hosting primitive behind Cloudflarebase.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cloudflarebase/cloudflarebase.git",
		"directory": "agents/hosting"
	},
	"homepage": "https://github.com/cloudflarebase/cloudflarebase/tree/main/agents/hosting#readme",
	"bugs": "https://github.com/cloudflarebase/cloudflarebase/issues",
	"keywords": [
		"cloudflare",
		"workers",
		"workers-for-platforms",
		"durable-objects",
		"hosting",
		"static-assets",
		"agents",
		"cloudflarebase"
	],
	"publishConfig": {
		"access": "public"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./wrangler-fragment.jsonc": "./template/wrangler-fragment.jsonc",
		"./cloudflarebase.agent.json": "./cloudflarebase.agent.json",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"template",
		"NOTICE",
		"cloudflarebase.agent.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test:unit": "node --import tsx --test src/route-access.unit.test.ts src/tar.unit.test.ts src/cloudflare.unit.test.ts src/crypto.unit.test.ts src/build-env.unit.test.ts",
		"prepublishOnly": "npm run build",
		"deploy": "wrangler deploy",
		"deploy:outbound": "wrangler deploy --config wrangler.outbound.jsonc",
		"deploy:outbound:preview": "wrangler deploy --config wrangler.outbound.jsonc --env preview",
		"deploy:preview": "npm run deploy:outbound:preview && wrangler deploy --env preview",
		"dev": "wrangler dev --env local --persist-to=../../.wrangler/state/ --ip 0.0.0.0 --port 8790",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"dev:test": "wrangler dev --env test --ip 127.0.0.1 --port 8800 --persist-to ../../.wrangler/test-state/hosting-agent",
		"deploy:production": "npm run deploy:outbound && wrangler deploy --env production",
		"migrations": "drizzle-kit generate && node scripts/generate-migrations.mjs"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.20.0",
		"typescript": "^5.5.2",
		"wrangler": "^4.118.0"
	},
	"dependencies": {
		"@sentry/cloudflare": "^10.66.0",
		"agents": "^0.17.4",
		"drizzle-orm": "^0.45.2",
		"zod": "^4.4.3"
	}
}
