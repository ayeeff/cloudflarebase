{
	"manifestVersion": 1,
	"name": "hosting",
	"title": "Hosting",
	"description": "Apps and functions on Workers for Platforms - static assets and server code in one deploy, served at your subdomain.",
	"packageName": "@cloudflarebase/hosting",
	"worker": "hosting-agent",
	"durableObjects": [{ "class": "HostingAgent", "scope": "perProject" }],
	"entrypoint": { "assertEnvType": "AssertHostingAgentEnv" },
	"erase": { "method": "DELETE", "path": "/internal/projects/:projectId" },
	"bindings": {},
	"secrets": {
		"generated": [],
		"optional": ["CF_ACCOUNT_ID", "CF_HOSTING_API_TOKEN", "SENTRY_DSN"]
	},
	"vars": {
		"HOSTING_DOMAIN": {
			"default": "",
			"hint": "Apex domain apps serve under (e.g. cfbase.dev). Empty disables the serving path."
		},
		"DISPATCH_NAMESPACE": {
			"default": "",
			"hint": "Workers for Platforms dispatch namespace name the DISPATCH binding targets."
		}
	},
	"routes": [
		{ "path": "/overview", "access": "operator" },
		{ "path": "/apps/*", "access": "operator" },
		{ "path": "/deploys", "access": "operator" }
	],
	"proxy": { "apiPrefix": "hosting", "agentBasePath": "" },
	"permissions": [],
	"console": {
		"section": "Hosting",
		"icon": "rocket",
		"pages": [{ "path": "/hosting", "title": "Hosting", "testId": "nav-hosting", "icon": "rocket" }]
	}
}
