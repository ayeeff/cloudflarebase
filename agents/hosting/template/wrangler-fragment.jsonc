/**
 * Wrangler fragment for the Cloudflarebase hosting agent.
 *
 * `cloudflarebase add hosting` merges these keys into your wrangler.jsonc:
 * comments survive, your existing values are never overwritten, and Durable
 * Object migrations append under your next free tag.
 *
 * The `migrations` block below is a FRESH v1 declaring the HostingAgent
 * class. Do not copy the tag history from the Cloudflarebase repository.
 *
 * Workers for Platforms is a PAID Cloudflare add-on, and this fragment
 * deliberately does not assume you have it: with only these keys the agent
 * deploys, records nothing, and answers hosting requests with a 503 pointing
 * at the setup steps. To actually serve apps you additionally need, by hand:
 *
 *   1. A dispatch namespace: `npx wrangler dispatch-namespace create <name>`,
 *      then a binding here -
 *        "dispatch_namespaces": [{ "binding": "DISPATCH", "namespace": "<name>" }]
 *      (add "outbound": { "service": "<your outbound worker>", "parameters":
 *      ["subdomain"] } and the var "DISPATCH_OUTBOUND": "true" if you deploy
 *      one - optional but recommended; see src/outbound.ts in the package
 *      repository for the v1 pass-through).
 *   2. Vars: DISPATCH_NAMESPACE (the namespace name - the REST API needs it)
 *      and HOSTING_DOMAIN (the apex your apps serve under).
 *   3. Secrets: `wrangler secret put CF_ACCOUNT_ID` and
 *      `wrangler secret put CF_HOSTING_API_TOKEN` (Workers Scripts edit).
 *   4. A wildcard route `*.<your-domain>/*` to this worker on your zone.
 */
{
	"migrations": [{ "new_sqlite_classes": ["HostingAgent"], "tag": "v1" }],
	"durable_objects": {
		"bindings": [{ "class_name": "HostingAgent", "name": "HostingAgent" }],
	},
	"vars": {
		// Empty disables the serving path; set your apex domain to enable it.
		"HOSTING_DOMAIN": "",
		// The Workers for Platforms dispatch namespace name (see header).
		"DISPATCH_NAMESPACE": "",
		/**
		 * DELIBERATELY ABSENT: "EXPOSE_OPERATOR_API": "true".
		 *
		 * Every route this agent serves deploys code, mints subdomains, writes
		 * secrets, or reports what is deployed, and none of them authenticate a
		 * caller - they are meant to sit behind a console that already has. On
		 * this Worker, which serves your application on a public hostname, they
		 * answer 404. Serving deployed apps on your wildcard hostname is
		 * unaffected.
		 *
		 * Your own code is unaffected too: reach the agent through the
		 * HostingAgent Durable Object namespace binding, which no HTTP caller
		 * can.
		 *
		 * Set it ONLY on a Worker that has no public hostname of its own
		 * (workers_dev false, no route beyond the app wildcard) and is fronted
		 * by something that authenticates operators.
		 */
		// Set your own with `wrangler secret put SENTRY_DSN` to turn on error
		// reporting; empty disables it.
		"SENTRY_DSN": "",
	},
	"secrets": {
		"required": [],
	},
}
