/**
 * The dispatch namespace's outbound Worker - every `fetch()` a hosted app
 * makes flows through here. v1 is a deliberate pass-through: attaching it
 * from the FIRST deploy means Phase C's egress metering and policy blocking
 * are a change to this Worker, never a redeploy of user scripts. It is its
 * own Worker (not an env of hosting-agent) because the dispatch-namespace
 * binding names a service, and that service must exist before any config
 * referencing it deploys - `npm run deploy:production` / `deploy:preview`
 * encode the order.
 *
 * One outbound PER ENVIRONMENT (top level = production, env.preview below),
 * even though the pass-through has no per-environment state: the preview
 * deploy workflow redeploys the outbound on every push to `preview`, so a
 * shared instance would put preview-branch outbound code on production
 * apps' egress - the exact preview-onto-production bleed the rest of the
 * stack is built to prevent, and the whole reason to rehearse Phase C's
 * metering on preview first.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hosting-outbound",
	"main": "src/outbound.ts",
	"compatibility_date": "2026-07-10",
	"observability": {
		"logs": { "enabled": true, "invocation_logs": false },
	},
	"workers_dev": false,
	"preview_urls": false,
	"env": {
		"preview": {
			// Serves cfbase-apps-preview via env.preview's outbound binding in
			// wrangler.jsonc. Must exist before hosting-agent-preview deploys.
			"name": "hosting-outbound-preview",
			"workers_dev": false,
			"preview_urls": false,
		},
	},
}
