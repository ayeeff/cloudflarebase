/**
 * The dispatch namespace's outbound Worker - every `fetch()` a hosted app
 * makes flows through here. v1 is a deliberate pass-through: attaching it
 * from the FIRST deploy means Phase C's egress metering and policy blocking
 * are a change to this Worker, never a redeploy of user scripts. It is its
 * own Worker (not an env of hosting-agent) because the dispatch-namespace
 * binding names a service, and that service must exist before any config
 * referencing it deploys - `npm run deploy:production` deploys this first.
 *
 * One instance serves both namespaces: the pass-through has no
 * per-environment state, and the `subdomain` parameter arrives per dispatch.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hosting-outbound",
	"main": "src/outbound.ts",
	"compatibility_date": "2026-07-10",
	"observability": {
		"logs": { "enabled": true, "invocation_logs": false }
	},
	"workers_dev": false,
	"preview_urls": false
}
