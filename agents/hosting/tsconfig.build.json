/**
 * Publish build for `@cloudflarebase/hosting`.
 *
 * Emits `dist/` from `src/` only. Deliberately left out of the published
 * package:
 *
 * - `worker-configuration.d.ts` is a `types` entry rather than an input, so it
 *   is never emitted. Shipping it would declare a global `interface Env` in the
 *   consumer's project and clobber their own generated bindings - the exact
 *   opposite of what makes this package portable.
 * - `src/env.d.ts` is a declaration input, which tsc does not copy to `outDir`.
 *   Its augmentation describes deployment shapes, not the consumer's config.
 * - `bindings.test-d.ts` (the binding-contract negatives), executed by
 *   `tsc --noEmit` instead.
 *
 * The emitted declarations name `Env` instead of inlining it, so in a consumer
 * project it resolves to their `wrangler types` output. `AssertHostingAgentEnv`
 * is what checks that output actually carries the bindings the agent reads.
 */
{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src"
	},
	"include": ["src/**/*"],
	"exclude": ["src/**/*.test-d.ts", "src/**/*.unit.test.ts"]
}
