{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudflarebase-com-test",
	"main": ".svelte-kit-e2e/cloudflare/_worker.js",
	"compatibility_date": "2026-07-10",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit-e2e/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cloudflarebase-control-plane",
			"database_id": "local",
			"preview_database_id": "D1"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "KV"
		}
	],
	"services": [
		{ "binding": "AUTH_AGENT", "service": "auth-agent-test" },
		{ "binding": "DB_AGENT", "service": "db-agent-test" },
		{ "binding": "HOSTING_AGENT", "service": "hosting-agent-test" }
	],
	// Fixed test-only admin password for the /admin fleet dashboard; keep
	// aligned with root wrangler.jsonc env.test and e2e/admin.ui.spec.ts.
	// DEMO_MODE mirrors env.test so dashboard specs can drive demo projects
	// without an operator session; named projects still require one.
	// No version_metadata binding here, deliberately. `wrangler dev` reports the
	// worker's START time as the version timestamp, so the first-run claim's
	// 30-minute deploy window would be open for most of a suite run and the gate
	// would never actually be exercised. With no binding there is no window, and
	// the setup token below is the only way in - which is the path the suite
	// pins (console.setup.ts asserts the claim is refused before it unlocks).
	"vars": {
		"ADMIN_SECRET": "e2e-admin-secret",
		// The first-run claim gate stays ON here: console.setup.ts unlocks with
		// this token before claiming, so the suite exercises the real path a
		// self-hosted operator takes. Never CONSOLE_SETUP_UNLOCKED, which would
		// switch the gate off and test nothing.
		"CONSOLE_SETUP_TOKEN": "e2e-console-setup-token-not-a-secret",
		"DEMO_MODE": "true",
		// The suite creates registry projects across many specs and a locally
		// reused stack accumulates them in the owner's personal org, so the
		// per-org ceiling must not bite here. MAX_BRANCHES_PER_ROOT stays at
		// its default of 5 on purpose - branches.api.spec.ts pins it.
		"MAX_PROJECTS_PER_ORG": "1000"
	}
}
